---
import resumeData from '../data/resume.json';

interface TimelineEntry {
  role?: string;
  degree: string;
  company?: string;
  institution: string;
  location: string;
  start: string;
  end: string;
  details: string[];
}

interface ResumeProject {
  title: string;
  description: string;
  tech: string;
  github: string;
}

interface Reference {
  name: string;
  designation: string;
  organization: string;
  phone: string;
  email: string;
}

interface Resume {
  basics: {
    name: string;
    title: string;
    location: string;
    email: string;
    phone: string;
    github: string;
    linkedin: string;
    summary: string;
  };
  education: TimelineEntry[];
  experience: TimelineEntry[];
  projects: ResumeProject[];
  references: { note: string; people: Reference[] };
  skills: { category: string; items: string[] }[];
}

const resume = resumeData as Resume;
const { basics, education, experience, projects, references, skills } = resume;

/** Strip the scheme so the printed link reads "github.com/…" rather than a full URL. */
const prettyUrl = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');

/** tel: hrefs need the digits only, no spaces or symbols. */
const telHref = (phone: string) => `tel:${phone.replace(/[^\d+]/g, '')}`;

const groups = [
  { id: 'experience', label: 'Experience', entries: experience, heading: 'Work Experience' },
  { id: 'education', label: 'Education', entries: education, heading: 'Education' },
];
---

<section id="resume" class="relative py-16 lg:py-24">
  <div class="container-site">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">Resume</h2>

      <a
        href="/dinesh-karki-resume.pdf"
        download="Dinesh-Karki-Resume.pdf"
        class="resume-no-print inline-flex shrink-0 items-center gap-2 self-start rounded-full bg-accent px-6 py-3 font-display text-sm font-semibold text-white transition duration-300 hover:bg-accent-bright hover:shadow-[0_0_30px_-5px_#a855f7] sm:self-auto"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-4 w-4"
          aria-hidden="true"
        >
          <path d="M12 3v12"></path>
          <path d="m7 10 5 5 5-5"></path>
          <path d="M5 21h14"></path>
        </svg>
        Download Resume (PDF)
      </a>
    </div>

    <div class="resume-grid mt-10 grid gap-6 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <div class="glass-card resume-card rounded-2xl p-6 sm:p-8">
          <div class="border-b border-white/10 pb-6">
            <h3 class="text-2xl font-bold">{basics.name}</h3>
            <p class="mt-1 text-sm text-accent-bright">{basics.title}</p>
            <p class="mt-3 text-sm leading-relaxed text-muted-soft">{basics.summary}</p>
            <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-xs text-muted-soft">
              <li>{basics.location}</li>
              <li>
                <a
                  class="resume-link -my-1 inline-block py-1 underline-offset-4 hover:underline"
                  href={`mailto:${basics.email}`}
                >
                  {basics.email}
                </a>
              </li>
              <li>
                <a
                  class="resume-link -my-1 inline-block py-1 underline-offset-4 hover:underline"
                  href={telHref(basics.phone)}
                >
                  {basics.phone}
                </a>
              </li>
              <li>
                <a
                  class="resume-link -my-1 inline-block py-1 underline-offset-4 hover:underline"
                  href={basics.github}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {prettyUrl(basics.github)}
                </a>
              </li>
              <li>
                <a
                  class="resume-link -my-1 inline-block py-1 underline-offset-4 hover:underline"
                  href={basics.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {prettyUrl(basics.linkedin)}
                </a>
              </li>
            </ul>
          </div>

          {
            groups.map(({ id, heading, entries }) => (
              <section class="mt-8 last:pb-0" aria-labelledby={`${id}-heading`}>
                <h4
                  id={`${id}-heading`}
                  class="font-display text-xs font-semibold uppercase tracking-[0.2em] text-muted"
                >
                  {heading}
                </h4>

                <ol class="resume-timeline mt-6 space-y-8">
                  {entries.map((entry) => (
                    <li class="resume-entry relative pl-8">
                      <span class="resume-dot" aria-hidden="true" />

                      <p class="resume-period font-display text-xs font-semibold tracking-wide">
                        {entry.start} — {entry.end}
                      </p>
                      <h5 class="mt-1 text-lg font-semibold leading-snug">
                        {entry.role ?? entry.degree}
                      </h5>
                      <p class="mt-0.5 text-sm text-muted-soft">
                        {entry.company ?? entry.institution}
                        <span class="text-muted-soft/70"> · {entry.location}</span>
                      </p>
                      <ul class="resume-details mt-3 space-y-1.5 text-sm leading-relaxed text-muted-soft">
                        {entry.details.map((detail) => (
                          <li>{detail}</li>
                        ))}
                      </ul>
                    </li>
                  ))}
                </ol>
              </section>
            ))
          }
        </div>
      </div>

      <div class="space-y-6">
        <div class="glass-card resume-card rounded-2xl p-6">
          <h4 class="font-display text-xs font-semibold uppercase tracking-[0.2em] text-muted">
            Projects
          </h4>
          <ul class="mt-5 space-y-4">
            {
              projects.map((project) => (
                <li class="resume-entry">
                  <p class="text-sm font-semibold leading-snug">{project.title}</p>
                  <p class="mt-0.5 text-xs leading-relaxed text-muted-soft">{project.description}</p>
                  <p class="mt-1 text-xs text-muted-soft/70">{project.tech}</p>
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="resume-link mt-1 inline-block text-xs font-medium underline-offset-4 hover:underline"
                  >
                    View on GitHub
                    <span class="sr-only"> — {project.title}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="glass-card resume-card rounded-2xl p-6">
          <h4 class="font-display text-xs font-semibold uppercase tracking-[0.2em] text-muted">
            Skills
          </h4>
          <dl class="mt-5 space-y-4">
            {
              skills.map((group) => (
                <div>
                  <dt class="font-display text-xs font-semibold text-accent-bright">
                    {group.category}
                  </dt>
                  <dd class="mt-1.5 flex flex-wrap gap-1.5">
                    {group.items.map((item) => (
                      <span class="rounded-md border border-white/10 bg-white/5 px-2 py-0.5 text-xs text-muted-soft">
                        {item}
                      </span>
                    ))}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="glass-card resume-card rounded-2xl p-6">
          <h4 class="font-display text-xs font-semibold uppercase tracking-[0.2em] text-muted">
            References
          </h4>
          <p class="mt-2 text-xs leading-relaxed text-muted-soft">{references.note}</p>
          <ul class="mt-4 space-y-4">
            {
              references.people.map((reference) => (
                <li class="resume-entry">
                  <p class="text-sm font-semibold leading-snug">{reference.name}</p>
                  <p class="mt-0.5 text-xs leading-relaxed text-muted-soft">
                    {reference.designation}
                    <span class="text-muted-soft/70"> · {reference.organization}</span>
                  </p>
                  <p class="mt-1 text-xs text-muted-soft/70">
                    <a
                      href={telHref(reference.phone)}
                      class="resume-link underline-offset-4 hover:underline"
                    >
                      {reference.phone}
                    </a>
                    <span aria-hidden="true"> · </span>
                    <a
                      href={`mailto:${reference.email}`}
                      class="resume-link underline-offset-4 hover:underline"
                    >
                      {reference.email}
                    </a>
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .resume-timeline {
    position: relative;
  }

  .resume-timeline::before {
    content: '';
    position: absolute;
    top: 6px;
    bottom: 0;
    left: 5px;
    width: 1px;
    background: linear-gradient(to bottom, #8b5cf6, rgba(139, 92, 246, 0.08));
  }

  .resume-dot {
    position: absolute;
    top: 4px;
    left: 0;
    height: 11px;
    width: 11px;
    border-radius: 9999px;
    border: 2px solid #8b5cf6;
    background-color: #0f0b1a;
    box-shadow: 0 0 12px -1px #a855f7;
  }

  .resume-period {
    color: #a78bfa;
  }

  .resume-details > li {
    position: relative;
    padding-left: 1rem;
  }

  .resume-details > li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: #8b5cf6;
  }
</style>
