---
import { site, isFormspreeConfigured, socialLinks } from '../data/site';
import { siGithub } from 'simple-icons';

/**
 * Official brand glyphs, drawn in `currentColor` so they stay legible on the
 * dark section. GitHub's own brand colour is near-black (#181717) and would be
 * invisible here. LinkedIn is no longer published in `simple-icons`, so its
 * official "in" mark is inlined.
 *
 * Each glyph keeps its own viewBox: the two paths are drawn on different grids
 * (GitHub 24x24, LinkedIn 16x16) and sharing one box clips one of them.
 */
const brandIcons: Record<string, { path: string; viewBox: string }> = {
  GitHub: { path: siGithub.path, viewBox: '0 0 24 24' },
  LinkedIn: {
    path:
      'M3.58 1.808a1.754 1.754 0 1 1-3.508 0 1.754 1.754 0 0 1 3.508 0ZM.18 3.919h3.2V16H.18V3.919Zm5.238 0h3.068V5.16h.044c.427-.807 1.47-1.658 3.024-1.658 3.232 0 3.826 2.126 3.826 4.892V16h-3.2v-5.106c0-1.217-.023-2.78-1.694-2.78-1.695 0-1.955 1.324-1.955 2.693V16H5.418V3.919Z',
    viewBox: '0 0 16 16',
  },
};

/**
 * A bare `mailto:` hands the request to the operating system's registered mail
 * handler. Where none is set up (a common Windows state) the click falls
 * through an app chooser and an account picker and then opens nothing. Linking
 * the compose page directly opens a real compose window in the browser with the
 * recipient prefilled, so the click always does something visible.
 */
const emailSubject = encodeURIComponent(`New message from ${site.author}'s portfolio`);

const contactLinks = socialLinks.map((link) =>
  link.label === 'Email'
    ? {
        ...link,
        href: `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(site.email)}&su=${emailSubject}`,
      }
    : link
);
---

<section id="contact" class="relative py-16 lg:py-24">
  <div class="container-site grid gap-12 lg:grid-cols-2 lg:gap-16">
    <div>
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">Get in touch</h2>
      <p class="mt-4 max-w-lg text-base text-muted-soft sm:text-lg">
        Open to internships, research assistantships and interesting data problems. Send a note and
        I will reply from Kathmandu.
      </p>

      <ul class="mt-8 flex items-center gap-3">
        {
          contactLinks.map((link) => {
            const isEmail = link.label === 'Email';
            const external = link.href.startsWith('http');
            const icon = brandIcons[link.label];
            return (
              <li>
                <a
                  href={link.href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                  aria-label={isEmail ? `Email ${site.email}` : link.label}
                  class="group inline-flex h-12 w-12 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-muted-soft transition duration-300 hover:-translate-y-0.5 hover:border-accent/60 hover:bg-white/[0.09] hover:text-accent-bright hover:shadow-[0_0_24px_-8px_#a855f7]"
                >
                  {icon ? (
                    <svg viewBox={icon.viewBox} fill="currentColor" class="h-6 w-6" aria-hidden="true">
                      <path d={icon.path} />
                    </svg>
                  ) : (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="h-6 w-6"
                      aria-hidden="true"
                    >
                      <rect x="2.5" y="5" width="19" height="14" rx="2" />
                      <path d="m3 7 9 6 9-6" />
                    </svg>
                  )}
                  <span class="sr-only">{link.label}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>

    <form
      id="contact-form"
      class="glass-card rounded-2xl p-6 sm:p-8"
      action={site.formspreeEndpoint}
      method="POST"
      data-endpoint={site.formspreeEndpoint}
      data-configured={String(isFormspreeConfigured)}
      novalidate
    >
      <input type="hidden" name="subject" value={`New message from ${site.author}'s portfolio`} />
      <div class="hidden" aria-hidden="true">
        <label for="contact-gotcha">Leave this field empty</label>
        <input id="contact-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
      </div>

      {
        !isFormspreeConfigured && (
          <p class="mb-6 rounded-xl border border-amber-400/30 bg-amber-400/10 px-4 py-3 text-xs leading-relaxed text-amber-200">
            <strong class="font-semibold">Not configured yet.</strong> Set a real Formspree form id
            in <code class="font-display">src/data/site.ts</code> before publishing, or submissions
            will be rejected.
          </p>
        )
      }

      <div class="space-y-5">
        <div>
          <label
            for="contact-name"
            class="mb-2 block font-display text-xs font-semibold uppercase tracking-widest text-muted-soft"
          >
            Name
          </label>
          <input
            id="contact-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            placeholder="Your name"
            class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-muted-soft/50 transition duration-300 focus:border-accent/60 focus:bg-white/[0.07] focus:outline-none focus:ring-1 focus:ring-accent/60"
          />
        </div>

        <div>
          <label
            for="contact-email"
            class="mb-2 block font-display text-xs font-semibold uppercase tracking-widest text-muted-soft"
          >
            Email
          </label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-muted-soft/50 transition duration-300 focus:border-accent/60 focus:bg-white/[0.07] focus:outline-none focus:ring-1 focus:ring-accent/60"
          />
        </div>

        <div>
          <label
            for="contact-message"
            class="mb-2 block font-display text-xs font-semibold uppercase tracking-widest text-muted-soft"
          >
            Message
          </label>
          <textarea
            id="contact-message"
            name="message"
            rows="5"
            required
            placeholder="What are you working on?"
            class="w-full resize-y rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-muted-soft/50 transition duration-300 focus:border-accent/60 focus:bg-white/[0.07] focus:outline-none focus:ring-1 focus:ring-accent/60"
          ></textarea>
        </div>

        <button
          id="contact-submit"
          type="submit"
          class="w-full rounded-xl bg-accent px-6 py-3 font-display text-sm font-semibold text-white transition duration-300 hover:bg-accent-bright hover:shadow-[0_0_30px_-5px_#a855f7] disabled:cursor-not-allowed disabled:opacity-60 disabled:hover:bg-accent disabled:hover:shadow-none"
        >
          Send message
        </button>

        <p
          id="contact-status"
          role="status"
          aria-live="polite"
          class="hidden text-sm leading-relaxed"
        >
        </p>
      </div>
    </form>
  </div>
</section>

<style>
  #contact-status.is-success {
    color: #6ee7b7;
  }

  #contact-status.is-error {
    color: #fca5a5;
  }
</style>

<script is:inline>
  (function () {
    var form = document.getElementById('contact-form');
    if (!form) return;

    var status = document.getElementById('contact-status');
    var submit = document.getElementById('contact-submit');
    var endpoint = form.dataset.endpoint;
    var configured = form.dataset.configured === 'true';
    var submitLabel = submit.textContent;

    var showStatus = function (message, kind) {
      status.textContent = message;
      status.classList.remove('hidden', 'is-success', 'is-error');
      status.classList.add(kind === 'success' ? 'is-success' : 'is-error');
    };

    form.addEventListener('submit', function (event) {
      event.preventDefault();

      if (!configured) {
        showStatus(
          'This form is not connected to a Formspree endpoint yet, so the message was not sent.',
          'error'
        );
        return;
      }

      // Honeypot: real users never fill this in.
      if (form.elements._gotcha && form.elements._gotcha.value) {
        return;
      }

      if (!form.reportValidity()) return;

      submit.disabled = true;
      submit.textContent = 'Sending…';
      form.setAttribute('aria-busy', 'true');
      status.classList.add('hidden');

      fetch(endpoint, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      })
        .then(function (response) {
          if (!response.ok) {
            var error = new Error('Request failed with ' + response.status);
            error.status = response.status;
            throw error;
          }
          form.reset();
          showStatus('Thanks — your message is on its way. I usually reply within a day or two.', 'success');
        })
        .catch(function (error) {
          // Formspree rate-limits AJAX forms with a 429 and requires the
          // visitor be told to wait rather than just retrying blindly.
          if (error && error.status === 429) {
            showStatus(
              'Too many messages were sent in a short time. Please wait a minute and try again, or email me directly.',
              'error'
            );
            return;
          }
          showStatus(
            'Something went wrong and the message was not sent. Please try again, or email me directly.',
            'error'
          );
        })
        .then(function () {
          submit.disabled = false;
          submit.textContent = submitLabel;
          form.removeAttribute('aria-busy');
        });
    });
  })();
</script>
