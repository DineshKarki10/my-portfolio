---
import { site, socialLinks } from '../data/site';

const navLinks = [
  { label: 'Projects', href: '#projects' },
  { label: 'Expertise', href: '#expertise' },
  { label: 'Resume', href: '#resume' },
  { label: 'Contact', href: '#contact' },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent bg-[#0f0b1a]/80 backdrop-blur-md transition-colors duration-300"
>
  <div class="container-site flex h-16 items-center justify-between gap-3 sm:gap-4">
    <a
      href="#top"
      class="-my-2 inline-flex items-center py-2 font-mono text-lg font-bold tracking-tight text-white transition-colors duration-300 hover:text-accent-bright sm:text-xl"
    >
      {site.author}
      <span class="terminal-caret" aria-hidden="true"></span>
      <span class="sr-only">— back to top</span>
    </a>

    <div class="flex items-center gap-3 sm:gap-5 md:gap-6">
      <nav aria-label="Primary" class="hidden md:block">
        <ul class="flex items-center gap-6">
          {
            navLinks.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  data-nav-link={href}
                  class="nav-link block py-2 font-display text-sm font-medium text-muted-soft transition-colors duration-300 hover:text-white"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div
        class="flex items-center gap-2 rounded-full border border-purple-500/30 bg-purple-950/50 px-2.5 py-1.5 text-purple-300 sm:px-3"
        title="Nepal Time (UTC+5:45)"
      >
        <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-purple-400 opacity-75"
          ></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-purple-400"></span>
        </span>
        <span
          id="npt-clock"
          class="font-display text-xs font-medium tabular-nums tracking-wide"
          aria-live="off"
        >
          --:-- --</span
        >
        <span class="hidden text-[11px] font-semibold tracking-widest text-purple-400/80 sm:inline"
          >NPT</span
        >
      </div>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        class="-mr-2 inline-flex h-10 w-10 items-center justify-center rounded-lg text-white transition-colors duration-300 hover:bg-white/5 md:hidden"
      >
        <span class="relative block h-4 w-5" aria-hidden="true">
          <span class="absolute left-0 top-0 h-0.5 w-full rounded bg-current transition-all duration-300"></span>
          <span class="absolute left-0 top-[7px] h-0.5 w-full rounded bg-current transition-all duration-200"></span>
          <span class="absolute left-0 top-3.5 h-0.5 w-full rounded bg-current transition-all duration-300"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" data-open="false" class="fixed inset-0 z-40 md:hidden" inert>
  <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" data-menu-close></div>

  <nav
    data-menu-panel
    aria-label="Mobile"
    class="absolute bottom-0 right-0 top-16 flex w-72 max-w-[85vw] flex-col gap-2 overflow-y-auto border-l border-white/10 bg-[#0f0b1a] px-6 py-6"
  >
    <ul class="flex flex-col">
      {
        navLinks.map(({ label, href }) => (
          <li class="border-b border-white/5 last:border-b-0">
            <a
              href={href}
              data-menu-link
              data-nav-link={href}
              class="nav-link block py-4 font-display text-lg font-semibold text-white transition-colors duration-300 hover:text-accent-bright"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <ul class="mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-6">
      {
        socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="-my-2 inline-block py-2 font-display text-sm font-medium text-muted-soft transition-colors duration-300 hover:text-accent-bright"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style>
  #site-header.is-scrolled {
    border-bottom-color: color-mix(in srgb, white 10%, transparent);
    background-color: color-mix(in srgb, #0f0b1a 90%, transparent);
  }

  /* Section currently occupying the top of the screen. */
  .nav-link[aria-current='true'] {
    color: #a855f7;
  }

  #mobile-menu {
    opacity: 0;
    visibility: hidden;
    /* Stepped visibility: hidden is delayed until the fade-out finishes, but
       applied immediately on open so the panel can receive focus. */
    transition:
      opacity 0.25s ease,
      visibility 0s linear 0.25s;
  }

  #mobile-menu[data-open='true'] {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.25s ease,
      visibility 0s linear 0s;
  }

  #mobile-menu [data-menu-panel] {
    transform: translateX(100%);
    transition: transform 0.25s ease-out;
  }

  #mobile-menu[data-open='true'] [data-menu-panel] {
    transform: translateX(0);
  }

  [data-menu-toggle][aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  [data-menu-toggle][aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }

  [data-menu-toggle][aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-menu,
    #mobile-menu [data-menu-panel],
    [data-menu-toggle] span {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var clock = document.getElementById('npt-clock');
    if (clock) {
      var formatter = new Intl.DateTimeFormat('en-US', {
        timeZone: 'Asia/Kathmandu',
        hour: '2-digit',
        minute: '2-digit',
        hour12: true,
      });
      var tick = function () {
        clock.textContent = formatter.format(new Date());
      };
      tick();
      setInterval(tick, 1000);
    }

    var header = document.getElementById('site-header');
    if (header) {
      var onScroll = function () {
        header.classList.toggle('is-scrolled', window.scrollY > 8);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    // Mark whichever section currently sits at the top of the screen.
    // Anchor jumps themselves are aligned purely by `scroll-padding-top` in
    // global.css; this only tracks the section for the active-link highlight.
    // Deferred to DOMContentLoaded: this inline script runs in place, before
    // the sections it measures have been parsed.
    var initNavSpy = function () {
      // Group links by target section: each section is linked from both the
      // desktop and the mobile nav, and all of its links highlight together.
      var byId = [];
      document.querySelectorAll('[data-nav-link]').forEach(function (link) {
        var id = link.getAttribute('data-nav-link').slice(1);
        var el = document.getElementById(id);
        if (!el) return;
        var entry = byId.filter(function (s) {
          return s.id === id;
        })[0];
        if (!entry) {
          entry = { id: id, el: el, links: [] };
          byId.push(entry);
        }
        entry.links.push(link);
      });
      if (!byId.length) return;

      var setActive = function () {
        var headerHeight = header ? header.offsetHeight : 64;
        var current = byId[0];
        byId.forEach(function (s) {
          if (s.el.getBoundingClientRect().top - headerHeight <= 8) current = s;
        });
        // The last section can never reach the top: the document runs out of
        // scroll height. Once fully scrolled, treat it as the current section.
        if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
          current = byId[byId.length - 1];
        }
        byId.forEach(function (s) {
          s.links.forEach(function (link) {
            if (s === current) link.setAttribute('aria-current', 'true');
            else link.removeAttribute('aria-current');
          });
        });
      };

      var ticking = false;
      window.addEventListener(
        'scroll',
        function () {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () {
            setActive();
            ticking = false;
          });
        },
        { passive: true }
      );
      setActive();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initNavSpy);
    } else {
      initNavSpy();
    }

    // Mobile drawer
    var menu = document.getElementById('mobile-menu');
    var toggle = document.querySelector('[data-menu-toggle]');
    if (!menu || !toggle) return;

    var panel = menu.querySelector('[data-menu-panel]');

    var setOpen = function (open, restoreFocus) {
      menu.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');

      if (open) {
        menu.removeAttribute('inert');
        document.body.style.overflow = 'hidden';
        var first = panel && panel.querySelector('a');
        if (first) first.focus();
      } else {
        menu.setAttribute('inert', '');
        document.body.style.overflow = '';
        if (restoreFocus !== false) toggle.focus();
      }
    };

    toggle.addEventListener('click', function () {
      setOpen(menu.dataset.open !== 'true', true);
    });

    menu.querySelectorAll('[data-menu-close], [data-menu-link]').forEach(function (el) {
      el.addEventListener('click', function () {
        // Close synchronously, before the anchor navigation's default action,
        // otherwise the page is still scroll-locked when it tries to jump.
        setOpen(false, false);
      });
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && menu.dataset.open === 'true') {
        setOpen(false, true);
      }
    });

    window.addEventListener('resize', function () {
      if (window.innerWidth >= 768 && menu.dataset.open === 'true') {
        setOpen(false, false);
      }
    });
  })();
</script>
